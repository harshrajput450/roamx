# ==============================================================================
# ROAMX Expeditions — Environment Variable Definitions
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend / Server-side Variables (Express Server & Netlify Functions)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID: Server-side Razorpay Key ID used to create payment orders.
# Note: The frontend dynamically receives keyId at runtime from the API (/api/payment/create-order).
# Do NOT define VITE_RAZORPAY_KEY_ID to prevent baking keys into client build bundles.
RAZORPAY_KEY_ID=rzp_test_your_key_id

# RAZORPAY_KEY_SECRET: Server-only secret key used for order creation & signature verification.
# Never expose this secret to client code or bundles.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Supabase (PostgreSQL Database, Auth & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL
APP_URL=http://localhost:3000

# Optional Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
